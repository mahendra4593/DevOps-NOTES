mount /dev/vgmain/lvdata /data
swapon /dev/vgmain/lvswap
```

Add to fstab:

```bash
/dev/vgmain/lvdata   /data   ext4   defaults   0   0
/dev/vgmain/lvswap   swap    swap   defaults   0   0
```

